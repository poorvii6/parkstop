generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  binaryTargets = ["native", "darwin-arm64", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bookings {
  id                Int       @id @default(autoincrement())
  user_id           Int?
  spot_id           Int?
  start_time        DateTime  @db.Timestamp(6)
  end_time          DateTime? @db.Timestamp(6)
  status            String?   @default("active") @db.VarChar(20)
  total_price       Decimal?  @db.Decimal(10, 2)
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  hours             Decimal   @default(1) @db.Decimal
  otp_code          String?   @db.VarChar(10)
  otp_expires_at    DateTime? @db.Timestamp(6)
  updated_at        DateTime? @default(now()) @db.Timestamp(6)
  actual_end_time   DateTime? @db.Timestamp(6)
  otp_attempts      Int?      @default(0)
  platform_fee      Decimal?  @default(0) @db.Decimal(10, 2)
  spotter_earning   Decimal?  @default(0) @db.Decimal(10, 2)
  vehicle_type      String?   @default("car") @db.VarChar(20)
  vehicle_subtype   String?   @db.VarChar(50)
  payment_id        String?   @db.VarChar(100)
  payment_method_id Int?
  payment_status    String?   @default("pending") @db.VarChar(20)
  payment_mode      String?   @default("online") @db.VarChar(20)
  checkout_otp      String?   @db.VarChar(10)
  slot_name         String?   @db.VarChar(50)

  // --- Prepaid bookings -------------------------------------------------
  // Flat fee charged when a booking is made 2h+ ahead. Stored rather than
  // re-derived, because by refund time the lead is history and the rate may
  // since have changed.
  advance_fee         Decimal?  @default(0) @db.Decimal(10, 2)
  // What was actually collected up front. Acts as a floor at checkout: leaving
  // early earns no refund, overstaying bills on top.
  amount_paid         Decimal?  @default(0) @db.Decimal(10, 2)
  // Refund lifecycle. refund_status is one of:
  //   null         nothing owed
  //   'claimable'  a no-show the finder may still claim
  //   'processing' handed to the gateway
  //   'processed'  money returned
  //   'failed'     network or 5xx error; retried by the sweep and by a claim
  //   'needs_review' Razorpay refused it (4xx) or amounts disagree; needs a human
  refund_amount       Decimal?  @db.Decimal(10, 2)
  refund_status       String?   @db.VarChar(20)
  refund_id           String?   @db.VarChar(100)
  refunded_at         DateTime? @db.Timestamp(6)
  // Separates a finder who cancelled from one who never arrived — different
  // rates, and only one of them has to ask.
  cancellation_reason String?   @db.VarChar(30)

  parking_spots parking_spots? @relation(fields: [spot_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users         users?         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  review        reviews?
  dispute       disputes?
  payments      payments[]

  @@index([user_id])
  @@index([spot_id])
  @@index([status])
  @@index([spot_id, status])
  @@index([user_id, status])
  @@index([created_at])
}

model locations {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  latitude   Decimal?  @db.Decimal(10, 8)
  longitude  Decimal?  @db.Decimal(11, 8)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model parking_spots {
  id              Int       @id @default(autoincrement())
  spotter_id      Int?
  title           String    @db.VarChar(100)
  description     String?
  price_per_hour  Decimal   @db.Decimal(10, 2)
  latitude        Decimal?  @db.Decimal(10, 8)
  longitude       Decimal?  @db.Decimal(11, 8)
  is_available    Boolean?  @default(true)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  address         String?
  base_price      Decimal?  @db.Decimal
  total_slots     Int?      @default(1)
  available_slots Int?      @default(1)
  location_type   String?   @db.VarChar(20)
  is_active       Boolean?  @default(true)
  updated_at      DateTime? @default(now()) @db.Timestamp(6)
  // Set when the owner deletes the spot. A deleted spot is never switched back
  // on by "go online" and is hidden from the owner's lists.
  deleted_at      DateTime? @db.Timestamp(6)
  amenities       Json?     @default("[]")
  bike_slots      Int?      @default(0)
  car_slots       Int?      @default(1)
  images          Json?     @default("[]")
  slot_names      Json?     @default("[]")

  /// This SPOT's own verification state, mirrored from spot_verifications.status
  /// so the finder can filter in SQL without a join -- the same trick
  /// users.verification_status plays for the person. Deliberately NOT called
  /// verification_status: findNearby already joins users, which has a column of
  /// that name, and an unqualified reference to it would be ambiguous.
  /// See constants/spotVerification.js for the states and what 'approved' means.
  spot_verification_status String? @default("not_started") @db.VarChar(20)

  bookings          bookings[]
  saved_spots       saved_spots[]
  users             users?              @relation(fields: [spotter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reviews           reviews[]
  spot_verification spot_verifications?

  @@index([spotter_id])
  @@index([is_active])
  @@index([is_available])
  @@index([latitude, longitude])
  @@index([location_type])
  @@index([spot_verification_status])
}

/// Per-spot property verification: one row per spot, the record behind
/// parking_spots.spot_verification_status.
///
/// Owner verification approves a PERSON. This verifies a PLACE: a document for
/// this address, in this person's name, read by an admin (desk) and confirmed
/// against the local record by our team (field). Both stages must pass before
/// a spot is visible or bookable.
///
/// A separate table rather than columns on parking_spots because findNearby
/// does `SELECT parking_spots.*` on every map query, and none of this belongs
/// in that row.
model spot_verifications {
  id      Int    @id @default(autoincrement())
  spot_id Int    @unique
  /// not_started | in_progress | desk_pending | desk_approved | approved | rejected | grandfathered
  status  String @default("not_started") @db.VarChar(20)

  // ── What the owner submitted ────────────────────────────────────────────
  doc_type               String?   @db.VarChar(30)
  /// Private Cloudinary id (type: authenticated). Admins get a signed URL;
  /// the document itself is never public.
  doc_public_id          String?   @db.VarChar(255)
  /// The address printed on the document, typed by the owner. The spot's own
  /// `address` column is not a substitute: every active spot in production has
  /// one shorter than ten characters.
  claimed_address        String?   @db.VarChar(300)
  /// owner | tenant. A tenant needs the landlord's consent (stage 3).
  relationship           String?   @db.VarChar(10)
  landlord_name          String?   @db.VarChar(150)
  landlord_noc_public_id String?   @db.VarChar(255)
  /// When the owner submitted. The 48-hour clock runs from here.
  submitted_at           DateTime? @db.Timestamp(6)

  /// Set by the backfill on spots that were live in the finder before per-spot
  /// verification existed, and never cleared.
  ///
  /// It is what stops such a spot DISAPPEARING the moment its owner starts the
  /// process: `status` moves to in_progress and then desk_pending, neither of
  /// which a driver may see, so without this a spot would drop out of the
  /// finder as a reward for complying. While this is set and no verdict has
  /// landed, the spot stays visible. See SpotVerificationPolicy.
  grandfathered_at       DateTime? @db.Timestamp(6)

  // ── Desk review: an admin reads the document (stage 2) ──────────────────
  /// The name as printed on the document, typed by the admin.
  name_on_document     String?   @db.VarChar(150)
  /// DIRECT_MATCH | GOOD_PARTIAL_MATCH | MODERATE_PARTIAL_MATCH | NO_MATCH,
  /// against owner_verifications.aadhaar_name. Advises the admin; it does not
  /// decide, because a human typed the input off a photograph.
  name_match           String?   @db.VarChar(30)
  /// Where claimed_address geocoded to, kept so address_match_metres can be
  /// explained months later instead of being an unaccountable number.
  geocoded_lat         Decimal?  @db.Decimal(10, 8)
  geocoded_lng         Decimal?  @db.Decimal(11, 8)
  geocode_source       String?   @db.VarChar(20)
  /// Metres from the geocoded address to the spot's pin. Mostly a measure of
  /// geocoder precision, so it flags for a human and never auto-decides.
  address_match_metres Int?
  desk_reviewed_by     Int?
  desk_reviewed_at     DateTime? @db.Timestamp(6)

  // ── Field check: our team at the regional office (stage 3) ─────────────
  field_office       String?   @db.VarChar(120)
  field_record_found Boolean?
  field_reference    String?   @db.VarChar(100)
  field_notes        String?   @db.VarChar(1000)
  field_checked_by   Int?
  field_checked_at   DateTime? @db.Timestamp(6)

  /// What the owner is told to fix.
  rejection_reason String? @db.VarChar(500)
  /// Append-only {at, by, stage, action, note}. The columns above hold the
  /// CURRENT state; this survives a resubmission, so who did what and when is
  /// still answerable after the second attempt overwrites the first.
  review_log       Json?   @default("[]")

  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)

  parking_spots parking_spots @relation(fields: [spot_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([submitted_at])
}

model payment_methods {
  id                 Int      @id @default(autoincrement())
  user_id            Int
  provider           String   @db.VarChar(50)
  provider_method_id String   @db.VarChar(255)
  method_type        String   @db.VarChar(20)
  last4              String?  @db.VarChar(4)
  brand              String?  @db.VarChar(50)
  is_default         Boolean  @default(false)
  created_at         DateTime @default(now()) @db.Timestamp(6)
  users              users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                       Int       @id @default(autoincrement())
  name                     String    @db.VarChar(100)
  email                    String    @unique @db.VarChar(150)
  firebase_uid             String?   @unique @db.VarChar(128)
  role                     String    @db.VarChar(20)
  created_at               DateTime? @default(now()) @db.Timestamp(6)
  phone                    String?   @db.VarChar(20)
  full_name                String?   @db.VarChar(255)
  stripe_account_id        String?   @db.VarChar(255)
  payout_provider          String?   @default("stripe") @db.VarChar(20)
  push_token               String?
  updated_at               DateTime? @default(now()) @db.Timestamp(6)
  balance                  Decimal   @default(0) @db.Decimal(10, 2)
  address                  String?   @db.VarChar(255)
  dob                      String?   @db.VarChar(20)
  // Payout fields for Spotters
  upi_id                   String?   @db.VarChar(50)
  bank_account_number      String?   @db.VarChar(20)
  bank_ifsc                String?   @db.VarChar(15)
  bank_account_name        String?   @db.VarChar(100)
  razorpay_contact_id      String?   @db.VarChar(50)
  razorpay_fund_account_id String?   @db.VarChar(50)
  cashfree_vendor_id       String?   @db.VarChar(60)
  cashfree_vendor_status   String?   @db.VarChar(30)
  payout_mode              String?   @default("upi") @db.VarChar(20)
  is_finder_registered     Boolean   @default(true)
  is_spotter_registered    Boolean   @default(false)
  // Quiet hours (local hour 0-23) during which push notifications are suppressed.
  // null on either = quiet hours disabled.
  quiet_hours_start        Int?
  quiet_hours_end          Int?
  // Legacy column from the old spotter-verification work. Kept so prisma db push
  // does not try to drop it (it holds data). Values: draft/pending/approved/rejected.
  verification_status      String?
  // Firebase sign-in times (auth_time, seconds) that passed the email code.
  // The API only accepts tokens from one of these sign-ins. Newest last, max 5.
  otp_auth_times           Int[]     @default([])

  bookings           bookings[]
  locations          locations[]
  parking_spots      parking_spots[]
  payment_methods    payment_methods[]
  withdrawals        withdrawals[]
  payout_requests    payout_requests[]
  saved_spots        saved_spots[]
  payouts            payouts[]
  reviews_given      reviews[]            @relation("reviewer")
  reviews_received   reviews[]            @relation("spotter_reviews")
  disputes           disputes[]
  device_tokens      device_tokens[]
  notifications      notifications[]
  owner_verification owner_verifications?

  @@index([email])
  @@index([role])
  @@index([push_token])
}

model device_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token      String    @unique
  platform   String?   @db.VarChar(20)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model notifications {
  id         Int       @id @default(autoincrement())
  user_id    Int
  title      String
  body       String?
  type       String?   @db.VarChar(40)
  data       Json?
  read       Boolean   @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([user_id, read])
}

model payouts {
  id                 Int       @id @default(autoincrement())
  user_id            Int
  booking_id         Int?
  amount             Decimal   @db.Decimal(10, 2)
  razorpay_payout_id String?   @db.VarChar(100)
  status             String    @default("pending") @db.VarChar(20)
  mode               String    @default("UPI") @db.VarChar(20)
  purpose            String?   @default("payout") @db.VarChar(50)
  narration          String?
  failure_reason     String?
  created_at         DateTime  @default(now()) @db.Timestamp(6)
  updated_at         DateTime? @default(now()) @db.Timestamp(6)
  users              users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // One payout per booking, enforced by the database.
  //
  // PayoutService.processBookingPayout already locks the booking row and
  // checks for an existing payout before crediting, but that is application
  // code: a second code path, a bad migration or a hand-written INSERT could
  // still credit an owner twice, and money paid twice does not come back.
  // booking_id is nullable and Postgres allows many NULLs under a unique
  // index, so payouts not tied to a booking are unaffected.
  // Replaces @@index([booking_id]) -- a unique constraint indexes the column.
  @@unique([booking_id])
  @@index([user_id])
  @@index([status])
}

/// An owner asks for their wallet balance to be sent to their verified bank
/// account. The balance is taken out of the wallet when they ask; an admin
/// sends the bank transfer by hand and marks it paid with the bank reference,
/// or rejects it and the money goes back to the wallet.
model payout_requests {
  id                 Int       @id @default(autoincrement())
  user_id            Int
  amount             Decimal   @db.Decimal(10, 2)
  /// requested | paid | rejected
  status             String    @default("requested") @db.VarChar(20)
  /// Bank details at the moment of the request, for the record.
  bank_account_name  String?   @db.VarChar(100)
  bank_account_last4 String?   @db.VarChar(4)
  bank_ifsc          String?   @db.VarChar(15)
  /// Bank transaction reference (UTR) entered by the admin when paid.
  reference          String?   @db.VarChar(100)
  /// Reason when rejected.
  note               String?   @db.VarChar(300)
  created_at         DateTime  @default(now()) @db.Timestamp(6)
  processed_at       DateTime? @db.Timestamp(6)
  processed_by       Int?
  users              users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status])
}

model withdrawals {
  id                Int      @id @default(autoincrement())
  user_id           Int
  amount            Decimal  @db.Decimal(10, 2)
  payment_method_id Int
  status            String   @default("pending") @db.VarChar(20)
  created_at        DateTime @default(now()) @db.Timestamp(6)
  users             users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model saved_spots {
  id            Int           @id @default(autoincrement())
  user_id       Int
  spot_id       Int
  created_at    DateTime?     @default(now()) @db.Timestamp(6)
  parking_spots parking_spots @relation(fields: [spot_id], references: [id], onDelete: Cascade)
  users         users         @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, spot_id])
}

model reviews {
  id          Int      @id @default(autoincrement())
  booking_id  Int      @unique // one review per booking
  reviewer_id Int // Finder's user ID
  spotter_id  Int // Spotter's user ID
  spot_id     Int
  rating      Int // 1-5
  comment     String?  @db.Text
  created_at  DateTime @default(now())

  bookings      bookings      @relation(fields: [booking_id], references: [id])
  reviewer      users         @relation("reviewer", fields: [reviewer_id], references: [id])
  spotter       users         @relation("spotter_reviews", fields: [spotter_id], references: [id])
  parking_spots parking_spots @relation(fields: [spot_id], references: [id])

  @@index([spotter_id])
  @@index([spot_id])
}

/// Pending email-verification codes for signup.
///
/// Deliberately NOT related to `users` — the whole point is that these exist
/// before an account does. Keyed by email, one live code per address.
///
/// Previously held in an in-process Map, which meant every Railway redeploy
/// silently invalidated the codes of anyone mid-signup, and which could never
/// work across more than one instance.
model email_otps {
  email      String   @id @db.VarChar(150)
  code       String   @db.VarChar(6)
  attempts   Int      @default(0)
  issued_at  DateTime @default(now())
  expires_at DateTime

  @@index([expires_at])
}

model disputes {
  id          Int      @id @default(autoincrement())
  booking_id  Int      @unique // one dispute per booking
  raised_by   Int
  reason      String   @db.VarChar(100)
  description String?  @db.Text
  status      String   @default("open") @db.VarChar(20)
  resolution  String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  bookings bookings @relation(fields: [booking_id], references: [id])
  user     users    @relation(fields: [raised_by], references: [id])

  @@index([status])
  @@index([booking_id])
}

/// Spot-owner identity verification (one row per owner).
/// Stores RESULTS only: no full Aadhaar number, no Aadhaar photo, no selfie.
model owner_verifications {
  id      Int    @id @default(autoincrement())
  user_id Int    @unique
  /// not_started | in_progress | pending | approved | rejected
  status  String @default("not_started") @db.VarChar(20)

  // Aadhaar via DigiLocker (Cashfree Secure ID)
  digilocker_verification_id String?   @db.VarChar(50)
  aadhaar_name               String?   @db.VarChar(150)
  aadhaar_last4              String?   @db.VarChar(4)
  aadhaar_dob                String?   @db.VarChar(20)
  aadhaar_gender             String?   @db.VarChar(10)
  aadhaar_state              String?   @db.VarChar(60)
  aadhaar_pincode            String?   @db.VarChar(10)
  aadhaar_verified_at        DateTime? @db.Timestamp(6)

  // PAN (masked + keyed hash for duplicate detection)
  pan_masked          String?   @db.VarChar(10)
  pan_hash            String?   @db.VarChar(64)
  pan_registered_name String?   @db.VarChar(150)
  pan_name_match      String?   @db.VarChar(30)
  pan_aadhaar_linked  String?   @db.VarChar(4)
  pan_verified_at     DateTime? @db.Timestamp(6)

  // Live selfie vs Aadhaar photo (scores only, no images kept)
  liveness_score     Float?
  face_match_score   Float?
  selfie_verified_at DateTime? @db.Timestamp(6)

  // Bank account (penny-less check); full number lives on users for payouts
  bank_last4        String?   @db.VarChar(4)
  bank_ifsc         String?   @db.VarChar(11)
  bank_name         String?   @db.VarChar(100)
  bank_name_at_bank String?   @db.VarChar(150)
  bank_name_match   String?   @db.VarChar(30)
  bank_verified_at  DateTime? @db.Timestamp(6)

  // Property proof (private Cloudinary upload, reviewed by admin)
  property_doc_type      String?   @db.VarChar(30)
  property_doc_public_id String?   @db.VarChar(255)
  property_address       String?   @db.VarChar(300)
  property_uploaded_at   DateTime? @db.Timestamp(6)

  // Review
  flags            Json?
  attempts         Json?
  submitted_at     DateTime? @db.Timestamp(6)
  reviewed_at      DateTime? @db.Timestamp(6)
  reviewed_by      Int?
  rejection_reason String?   @db.VarChar(500)
  created_at       DateTime  @default(now()) @db.Timestamp(6)
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([pan_hash])
}

/// Every captured payment, one row each.
///
/// bookings.payment_id is a single column, so an overstay top-up overwrites
/// the id of the payment that came before it and that earlier payment stops
/// existing anywhere. That was merely untidy until duplicate-payment refunds
/// arrived: _refundDuplicatePayment compared an incoming payment against
/// bookings.payment_id alone, so a late webhook retry of a legitimate earlier
/// payment looked like a second payment for a booking already paid, and was
/// refunded. A Rs450 prepayment followed by a Rs800 overstay top-up would
/// refund the Rs450 the moment Razorpay redelivered its webhook.
///
/// This table is the record of what actually arrived. The question
/// "have we seen this payment before?" is answered by looking it up here,
/// not by comparing one id against the most recent one.
model payments {
  id                  Int      @id @default(autoincrement())
  booking_id          Int
  /// Razorpay's payment id. UNIQUE is the point of the table: it makes
  /// "record this payment" idempotent in the database rather than only in
  /// application code, so a redelivered webhook cannot write a second row
  /// however the callers behave.
  razorpay_payment_id String   @unique @db.VarChar(100)
  /// Rupees that arrived, arrears included — what Razorpay captured.
  amount              Decimal  @db.Decimal(10, 2)
  /// The part of `amount` that settled older dues rather than this booking.
  arrears_cleared     Decimal  @default(0) @db.Decimal(10, 2)
  status              String   @default("captured") @db.VarChar(20)
  created_at          DateTime @default(now()) @db.Timestamp(6)

  bookings bookings @relation(fields: [booking_id], references: [id], onDelete: Cascade)

  @@index([booking_id])
}
