{
  "expo": {
    "name": "ParkStop",
    "slug": "parkstop",
    "scheme": "smart-parking",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0C14"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartparking.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ParkStop uses your location to show parking spots near you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.smartparking.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ParkStop uses your location to show parking spots near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "ParkStop uses your camera to take photos of your parking spot and for owner verification.",
          "photosPermission": "ParkStop uses your photos so you can upload pictures of your parking spot."
        }
      ],
      "expo-font",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ca58c2c3-fd5f-478d-9d2c-48d3caf65717"
      }
    },
    "owner": "poo123",
    "newArchEnabled": true
  }
}
