 public class MapViewController implements INavigationViewControllerProperties {
+  /**
+   * PARKSTOP PATCH — resolve marker icons from the filesystem as well as assets.
+   *
+   * The upstream code calls BitmapDescriptorFactory.fromAsset() only, which
+   * reads from the APK's bundled assets. That makes runtime-generated marker
+   * images impossible: a price pill rendered and captured while the app is
+   * running lives on disk, not in assets, so it can never be loaded.
+   *
+   * fromPath() is the filesystem equivalent and already exists in the same
+   * factory. Absolute paths (and file:// URIs) now go there; everything else
+   * keeps the original asset behaviour, so bundled icons are unaffected.
+   */
+  private static BitmapDescriptor parkstopResolveIcon(String imagePath) {
+    String p = imagePath;
+    if (p.startsWith("file://")) {
+      p = p.substring(7);
+    }
+    if (p.startsWith("/")) {
+      return BitmapDescriptorFactory.fromPath(p);
+    }
+    return BitmapDescriptorFactory.fromAsset(imagePath);
+  }
